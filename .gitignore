# virtualenv — recreate with the commands in README
.venv/
__pycache__/
*.pyc
.DS_Store

# cron's own stdout capture; the script keeps its own readable log
cards/topup_cron.log

# runtime log from the local web app
cards/app.log

# Other people's data stays out of the repository. football-data's files are
# downloaded by `python cards/loader.py --download`; the saved EFL articles the
# referee-parser tests read are kept locally only.
data/raw/
cards/testdata/

# Excel's lock file while the workbook is open; editor settings
~$*
.claude/
